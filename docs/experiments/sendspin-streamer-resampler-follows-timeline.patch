+async def pipewire_quantum() -> tuple[int, int] | None:
+    """(quantum, rate) of the PipeWire graph our parec runs in, or None.
+
+    PipeWire hands a monitor source each block of the mix as the sink takes
+    it, and the sink plays that block one quantum later (its Latency param
+    reads minQuantum 1.0). pactl reports 0 for both latencies under
+    pipewire-pulse, so the quantum is read from pw-top: the driver row above
+    the "+ parec" follower. pw-top's first pass prints zeros, hence -n 2.
+    """
