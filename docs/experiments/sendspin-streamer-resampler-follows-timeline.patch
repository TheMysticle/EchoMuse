+
+def _resample_following_input(state, source_pcm, source_format, input_timestamp_us):
+    expected = state.pending_input_timestamp_us
+    if expected is not None and state.pending_timestamp_us is not None:
+        jump = input_timestamp_us - expected
+        if 50 < abs(jump) <= 20_000:  # the library would ignore it
+            state.pending_input_timestamp_us = input_timestamp_us
+            state.pending_input_ts_residue = 0
+            state.pending_timestamp_us += jump
+            _resample_follow["n"] += 1
+            _resample_follow["us"] += jump
+            now = time.monotonic()
+            if now - _resample_follow["logged"] >= 10:
+                _resample_follow["logged"] = now
+                log.info("resampler followed %d timeline jump(s), %+.1f ms in all",
+                         _resample_follow["n"], _resample_follow["us"] / 1000)
+    return _ps_resample(state, source_pcm, source_format, input_timestamp_us)
