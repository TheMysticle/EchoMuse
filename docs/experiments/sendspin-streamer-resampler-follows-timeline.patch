+
+def _encode_on_commit_timeline(transformer, pcm_data, output_ts, duration_us):
+    frames = _ps_encode(transformer, pcm_data, output_ts, duration_us)
+    if not frames or frames[0][1] == output_ts:
+        return frames
+    if abs(sum(d for _, _, d in frames) - duration_us) > 1:
+        return frames
+    ts, out = output_ts, []
+    for data, _, dur in frames:
+        out.append((data, ts, dur))
+        ts += dur
+    return out
