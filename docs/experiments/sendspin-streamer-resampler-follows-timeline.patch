+    q, s = sorted(_lead_q), sorted(_lead_s)
+    log.info("frame lead: queued median %.1f min %.1f ms | sent median %.1f min %.1f ms (n=%d)",
+             q[len(q) // 2] / 1000 if q else -1, q[0] / 1000 if q else -1,
+             s[len(s) // 2] / 1000, s[0] / 1000, len(s))
+    _lead_q.clear()
+    _lead_s.clear()
