# 2026-10-26: end the dial task when a connection disconnects itself (queue overflow), so the streamer redials an Echo that comes back.
--- a/streamer.py
+++ b/streamer.py
@@ -203,6 +203,28 @@
 _conn.SendspinConnection.send_binary = _send_binary_logged
