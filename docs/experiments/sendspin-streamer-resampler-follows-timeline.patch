+class OwnTimeline:
+    """Play times for a live stream at a fixed lead, kept by the streamer.
+
+    aiosendspin's own timeline only ever moves later: every chunk that reaches
+    it late pushes the whole stream later for good. A fresh start is busy (the
+    player connecting, the encoder and resampler being built), its first
+    chunks are late, and a stream at an 80 ms lead settled at 100 ms on a
+    Radar while one started on a running pipeline settled at 82. Explicit
+    timestamps take that rule out: chunk n plays at anchor + n x 10 ms, and a
+    late chunk is simply sent with less lead.
+
+    The first WARM chunks go out as silence while the streamer measures where
+    the stream sits, then moves it onto lead + TARGET_EXTRA: later by
+    stretching the timeline, earlier by dropping silent chunks. Nothing
+    audible is cut.
+
+    After that it is only ever STEERED, never cut: every 2 s the median lead
+    is compared with the target and the timeline moved by at most MAX_STEP
+    either way. The Echo absorbs a timing error under 5 ms by repeating or
+    dropping single samples, at most 2 per 10.7 ms period (0.39% speed, how
+    it already follows its own DAC clock), so a 2 ms step is ~0.5 s of those
+    and never a gap, a skip or a jump. That covers PulseAudio raising its
+    capture latency after a start (~12 ms over the first 30 s, measured) and
+    the capture clock's few-ppm drift.
+
+    One exception, so this is never worse than the library's own rule: when
+    the lead sits more than SHORT under the target for two blocks of FAST
+    chunks running (a lasting jump in capture latency, not a stall and its
+    catch-up burst), the Echo is short of audio and steering would take tens
+    of seconds, so the timeline is moved later at once. That is one gap, the
+    same one aiosendspin's rebase would have made.
+    """
+
+    # WARM (500 ms of silence at a stream's start), WARM_JUDGED (judged on its
+    # last 200 ms, once the slow start is over), WINDOW (chunks per
+    # steady-state check, 2 s) and FAST (chunks per shortfall check, 200 ms)
+    # are counts of chunks, set per stream in __init__ from the chunk size.
+    BAND_US = 1_000           # dead band: the capture cadence moves the median in 0.7 ms steps
+    MAX_STEP_US = 2_000       # well inside the Echo's 5 ms snap threshold
+    TARGET_EXTRA_US = 2_000   # median lead above the setting, as the library settled
+    SHORT_US = 10_000         # lead this far under the target is eating the Echo's margin
+
+    def __init__(self, lead_us: int) -> None:
+        self.lead_us = lead_us
+        self.target_us = lead_us + self.TARGET_EXTRA_US
+        self.chunk_ms = CHUNK_MS  # fixed for the stream; a change restarts it
+        self.WARM = 500 // CHUNK_MS
+        self.WARM_JUDGED = 200 // CHUNK_MS
+        self.WINDOW = 2000 // CHUNK_MS
+        self.FAST = 200 // CHUNK_MS
+        self.anchor: int | None = None
+        self.n = 0
+        self.warm = 0
+        self.drops = 0
+        self.silent = True  # whether the chunk last timed should be sent as silence
+        self.samples: list[int] = []
+        self.fast: list[int] = []
+        self.short_blocks = 0
+        self.rebases = 0
+        self.steps = 0
+        self.stepped_us = 0
+        self.logged = 0.0
+
+    @property
+    def warming(self) -> bool:
+        return self.warm < self.WARM
+
+    def next(self, now_us: int) -> int | None:
+        """Play time for the chunk in hand, or None to drop it."""
+        if self.anchor is None:
+            self.anchor = now_us + self.target_us
+        if self.drops:
+            self.drops -= 1
+            return None
+        play = self.anchor + self.n * self.chunk_ms * 1000
+        slack = play - now_us
+        self.silent = self.warming
+        if self.warming:
+            self.warm += 1
+            if self.warm > self.WARM - self.WARM_JUDGED:
+                self.samples.append(slack)
+            if self.warm == self.WARM:
+                self._settle(sorted(self.samples)[len(self.samples) // 2], warm=True)
+        else:
+            self.samples.append(slack)
+            self.fast.append(slack)
+            if len(self.fast) >= self.FAST:
+                self._check_short(sorted(self.fast)[len(self.fast) // 2])
+            if len(self.samples) >= self.WINDOW:
+                self._settle(sorted(self.samples)[len(self.samples) // 2], warm=False)
+        self.n += 1
+        return play
+
+    def _check_short(self, median: int) -> None:
+        self.fast = []
+        if median >= self.target_us - self.SHORT_US:
+            self.short_blocks = 0
+            return
+        self.short_blocks += 1
+        if self.short_blocks < 2:
+            return
+        self.anchor += self.target_us - median  # later only: a gap, never a skip
+        self.short_blocks = 0
+        self.samples = []
+        self.rebases += 1
+        log.warning("stream lead fell to %.1fms for 400ms; moved %.1fms later at once (%d time(s))",
+                    median / 1000, (self.target_us - median) / 1000, self.rebases)
+
+    def _settle(self, median: int, warm: bool) -> None:
+        self.samples = []
+        chunk = self.chunk_ms * 1000
+        off = median - self.target_us
+        if warm:
+            if off > 0:
+                self.drops = -(-off // chunk)
+                off -= self.drops * chunk
+            self.anchor -= off  # off <= 0 here: a stretch, never a step back
+            log.info("stream settled %.1fms off its lead; %d silent chunk(s) dropped",
+                     (median - self.target_us) / 1000, self.drops)
+        elif abs(off) > self.BAND_US:
+            step = max(-self.MAX_STEP_US, min(self.MAX_STEP_US, -off))
+            self.anchor += step
+            self.steps += 1
+            self.stepped_us += step
+            now = time.monotonic()
+            if now - self.logged >= 60:
+                self.logged = now
+                log.info("lead steered %d time(s), %+.1f ms in all; last %+.1f ms (was %+.1f off)",
+                         self.steps, self.stepped_us / 1000, step / 1000, off / 1000)
+
