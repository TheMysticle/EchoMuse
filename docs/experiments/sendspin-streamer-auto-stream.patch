diff -ruN a/test_auto_stop.py b/test_auto_stop.py
--- a/test_auto_stop.py	1970-01-01 01:00:00.000000000 +0100
+++ b/test_auto_stop.py	2026-10-28 19:33:57.854553972 +0100
@@ -0,0 +1,115 @@
+"""AutoStop's rules. Run: python -m pytest test_auto_stop.py (or plain python)."""
+import importlib.util
+import pathlib
+import sys
+
+spec = importlib.util.spec_from_file_location("streamer", pathlib.Path(__file__).with_name("streamer.py"))
+streamer = importlib.util.module_from_spec(spec)
+sys.modules["streamer"] = streamer
+spec.loader.exec_module(streamer)
+AutoStop = streamer.AutoStop
+
+SOUND, ZEROS = -20.0, -120.0
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1000.0
+
+    def __call__(self):
+        return self.t
+
+
+def make(minutes=10):
+    c = Clock()
+    return AutoStop(minutes, clock=c), c
+
+
+def test_sound_keeps_it_streaming():
+    a, c = make()
+    for _ in range(1200):  # 20 min of sound, a chunk per second
+        c.t += 1
+        assert not a.heard(SOUND)
+        assert not a.due()
+    assert not a.idle
+
+
+def test_goes_idle_once_after_the_set_silence():
+    a, c = make(10)
+    a.heard(SOUND)
+    c.t += 10 * 60 - 1
+    a.heard(ZEROS)
+    assert not a.due()
+    c.t += 1
+    assert a.due()
+    assert a.idle
+    c.t += 60
+    assert not a.due()  # once only
+
+
+def test_no_chunks_at_all_counts_as_silence():
+    a, c = make(1)
+    c.t += 61  # nothing heard: a card that stopped delivering
+    assert a.due()
+
+
+def test_sound_ends_the_idle_spell_on_the_first_chunk():
+    a, c = make(1)
+    c.t += 61
+    assert a.due()
+    assert not a.heard(ZEROS)
+    assert a.idle
+    assert a.heard(SOUND)  # the first audible chunk wakes it
+    assert not a.idle
+    assert not a.heard(SOUND)  # and only that one
+    c.t += 30
+    assert not a.due()  # the silence counts again from the last sound
+
+
+def test_quiet_but_real_sound_is_sound():
+    a, c = make(1)
+    for _ in range(120):
+        c.t += 1
+        a.heard(-50.0)  # a very quiet scene still peaks well above -60 dBFS
+        assert not a.due()
+
+
+def test_the_threshold_is_the_peak_not_a_hiss():
+    a, c = make(1)
+    for _ in range(61):
+        c.t += 1
+        a.heard(AutoStop.SILENT_DB)  # at the threshold is silence
+    assert a.due()
+
+
+def test_zero_minutes_never_stops():
+    a, c = make(0)
+    c.t += 24 * 3600
+    assert not a.due()
+    assert not a.idle
+
+
+def test_reset_counts_from_now_and_streams():
+    a, c = make(1)
+    c.t += 61
+    assert a.due()
+    a.reset()
+    assert not a.idle
+    c.t += 59
+    assert not a.due()
+    c.t += 1
+    assert a.due()
+
+
+def test_silent_s():
+    a, c = make(5)
+    a.heard(SOUND)
+    c.t += 42
+    assert a.silent_s == 42
+
+
+if __name__ == "__main__":
+    for name, f in list(globals().items()):
+        if name.startswith("test_"):
+            f()
+    print("ok")
diff -ruN a/test_timeline.py b/test_timeline.py
--- a/test_timeline.py	1970-01-01 01:00:00.000000000 +0100
+++ b/test_timeline.py	2026-10-28 19:33:57.854584462 +0100
@@ -0,0 +1,84 @@
+"""OwnTimeline against inputs that run fast or slow. Run: python -m pytest test_timeline.py"""
+import importlib.util
+import pathlib
+import sys
+
+import numpy as np
+
+spec = importlib.util.spec_from_file_location("streamer", pathlib.Path(__file__).with_name("streamer.py"))
+streamer = importlib.util.module_from_spec(spec)
+sys.modules["streamer"] = streamer
+spec.loader.exec_module(streamer)
+OwnTimeline = streamer.OwnTimeline
+CHUNK_US = streamer.CHUNK_MS * 1000
+LEAD_US = 50_000
+
+
+def feed(rate, seconds, quiet, jitter_us=0, seed=0):
+    """Chunks arriving from a card whose clock runs at `rate` times real time.
+    Returns the lead of each sent chunk (us) and how many were dropped."""
+    t = OwnTimeline(LEAD_US)
+    rng = np.random.default_rng(seed)
+    n = int(seconds * 1e6 / CHUNK_US * rate)
+    slack, dropped = [], 0
+    for i in range(n):
+        now = int(i * CHUNK_US / rate + abs(rng.normal(0, jitter_us)))
+        q = quiet(i) if callable(quiet) else quiet
+        play = t.next(now, quiet=q)
+        if play is None:
+            dropped += 1
+            continue
+        if not t.warming:
+            slack.append(play - now)
+    return np.array(slack), dropped, t
+
+
+def test_correct_rate_with_jitter_drops_nothing():
+    # Silence at the right rate (a paused TV still locked): never touched.
+    s, dropped, t = feed(1.0, 120, quiet=True, jitter_us=700)
+    assert t.surplus == 0
+    assert abs(np.median(s[-500:]) - t.target_us) < 2_000
+
+
+def test_fast_card_with_no_signal_holds_the_lead():
+    # The ICUSBAUDIO7D with the TV off: ~50 kHz instead of 48 kHz.
+    s, dropped, t = feed(50_000 / 48_000, 300, quiet=True, jitter_us=700)
+    assert t.surplus > 0
+    assert s.max() < t.target_us + OwnTimeline.LONG_US + CHUNK_US
+    # Without the drop the lead would be ~12 s over by now.
+
+
+def test_sound_is_never_dropped_even_when_running_fast():
+    s, dropped, t = feed(1.04, 30, quiet=False)
+    assert t.surplus == 0
+
+
+def test_tv_back_on_starts_at_the_lead():
+    # Two minutes off (fast, silent), then the card locks and sound plays.
+    rate_off = 50_000 / 48_000
+    t = OwnTimeline(LEAD_US)
+    now = 0.0
+    for _ in range(int(120e6 / CHUNK_US * rate_off)):
+        now += CHUNK_US / rate_off
+        t.next(int(now), quiet=True)
+    leads = []
+    for _ in range(300):  # 3 s of programme at the right rate
+        now += CHUNK_US
+        play = t.next(int(now), quiet=False)
+        assert play is not None
+        leads.append(play - now)
+    assert max(leads) < t.target_us + OwnTimeline.LONG_US + CHUNK_US
+
+
+def test_quiet_pauses_inside_programme_are_not_shortened():
+    # Speech with 300 ms pauses at the right rate: the lead stays at the
+    # target, so no pause loses a chunk.
+    s, dropped, t = feed(1.0, 60, quiet=lambda i: (i // 30) % 2 == 1, jitter_us=700)
+    assert t.surplus == 0
+
+
+if __name__ == "__main__":
+    for name, f in list(globals().items()):
+        if name.startswith("test_"):
+            f()
+    print("ok")
