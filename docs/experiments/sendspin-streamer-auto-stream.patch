+class AutoStop:
+    """Auto stream: let the players go after `minutes` without sound, and
+    take them back the moment sound returns.
+
+    The capture keeps running while idle, which is how sound returning is
+    seen at all, so only the players' side stops: the stream ends, the group
+    is stopped and they drop to a discovery connection, exactly as on Stop.
+    That hands a grouped Echo back to its speaker group instead of holding it
+    on a silent low-latency stream. Silence is the chunk's PEAK under
+    SILENT_DB: a TV with nothing playing sends digital zeros, and any
+    programme peaks far above it within a second. No chunks at all (a card
+    that stops delivering) counts as silence too, because nothing refreshes
+    `last`. Reads the peak the level meter already computed: nothing is added
+    to the audio path, and a resumed stream starts at the same lead.
+    """
+
+    SILENT_DB = -60.0
+
+    def __init__(self, minutes: float, clock=time.monotonic) -> None:
+        self.minutes = minutes
+        self.clock = clock
+        self.idle = False
+        self.last = clock()
+
+    def heard(self, peak_db: float) -> bool:
+        """One chunk's peak. True when it ends an idle spell."""
+        if peak_db <= self.SILENT_DB:
+            return False
+        self.last = self.clock()
+        if self.idle:
+            self.idle = False
+            return True
+        return False
+
+    def due(self) -> bool:
+        """True once, when the silence has lasted long enough to go idle."""
+        if self.minutes <= 0 or self.idle:
+            return False
+        if self.clock() - self.last >= self.minutes * 60:
+            self.idle = True
+            return True
+        return False
+
+    def reset(self) -> None:
+        """A start or a stop by hand: streaming, and the silence counts from now."""
+        self.idle = False
+        self.last = self.clock()
+
+    @property
+    def silent_s(self) -> float:
+        return self.clock() - self.last
+
+
 # --------------------------------------------------------------------------
 # Discovery
 # --------------------------------------------------------------------------
