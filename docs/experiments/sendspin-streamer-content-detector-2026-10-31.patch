+"""The content detector's rules. Run: python -m pytest test_contentdetect.py"""
+import json
+import time
+
+from contentdetect import (MARKS_NAME, WINDOW_BYTES, ContentDetector, Decision, SampleStore,
+                           label_of, read_log)
+
+
+def test_labels():
+    assert label_of(0.9, 0.0) == "music"
+    assert label_of(0.9, 0.6) == "speech"
+    assert label_of(0.1, 0.1) == "other"
+
+
+def test_decision_needs_five_of_six_and_leaves_at_one():
+    d = Decision()
+    for _ in range(4):
+        assert d.push("music") == "not music"
+    assert d.push("music") == "music"
+    for _ in range(4):
+        assert d.push("speech") == "music"
+    assert d.push("speech") == "not music"
+
+
+def test_background_music_blip_does_not_switch():
+    d = Decision()
+    for label in ["music", "music", "speech", "music", "music", "speech", "music", "speech"]:
+        assert d.push(label) == "not music"
+
+
+def test_samples_on_a_change_and_rate_limited(tmp_path):
+    s = SampleStore(tmp_path)
+    assert s.wanted(0, "speech", "not music") == "decision changed"
+    assert s.wanted(5, "music", "not music") is None      # under a minute since the last
+    assert s.wanted(70, "speech", "not music") == "label changed"
+    assert s.wanted(75, "music", "music") == "decision changed"
+    assert s.wanted(700, "music", "music") == "periodic"
+
+
+def test_prune_keeps_under_the_cap_deleting_oldest(tmp_path):
+    for i in range(5):
+        (tmp_path / f"2026010{i}-000000.wav").write_bytes(b"x" * 100)
+    SampleStore(tmp_path, cap=250).prune()
+    assert sorted(f.name for f in tmp_path.glob("*.wav")) == ["20260103-000000.wav", "20260104-000000.wav"]
+
+
+def test_feed_is_cheap_and_hands_over_whole_windows(tmp_path):
+    d = ContentDetector(tmp_path)
+    chunk = bytes(range(256)) * 7 + bytes(208)
+    t = time.perf_counter()
+    for _ in range(3000):
+        d.feed(chunk)
+        if d.full:
+            assert len(d.full) == WINDOW_BYTES
+            d.full = None
+    assert (time.perf_counter() - t) / 3000 < 0.0005
+
+
+def test_feed_drops_a_window_when_the_worker_is_behind(tmp_path):
+    d = ContentDetector(tmp_path)
+    d.feed(bytes(WINDOW_BYTES))
+    first = d.full
+    d.feed(bytes(WINDOW_BYTES))
+    assert d.full is first and d.dropped == 1
+
+
+def test_log_hides_deleted_clips_and_latest_mark_wins(tmp_path):
+    (tmp_path / "20260101-000000.wav").write_bytes(b"x")
+    rows = [{"t": 1, "label": "music", "sample": "20260101-000000.wav"},
+            {"t": 2, "label": "music", "sample": "20260102-000000.wav"}]
+    (tmp_path / "content.jsonl").write_text("".join(json.dumps(r) + "\n" for r in rows) + "broken\n")
+    (tmp_path / MARKS_NAME).write_text(
+        '{"sample":"20260101-000000.wav","verdict":"right"}\n{"sample":"20260101-000000.wav","verdict":"wrong"}\n')
+    d = read_log(tmp_path)
+    assert d["records"][0]["sample"] == "20260101-000000.wav" and "sample" not in d["records"][1]
+    assert d["marks"]["20260101-000000.wav"] == "wrong"
