+const $=id=>document.getElementById(id);let D=null;
+const css={music:'var(--music)',speech:'var(--speech)',other:'var(--other)'};
+const when=t=>new Date(t*1000).toLocaleString([], {weekday:'short',hour:'2-digit',minute:'2-digit',second:'2-digit'});
