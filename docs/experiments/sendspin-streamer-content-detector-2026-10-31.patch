+"""What is playing: music, or not. LOG ONLY: it changes no setting.
+
+The stream loop only copies each chunk into a buffer (feed). A thread hands
+each full window down a pipe to a separate low-priority process, which runs
+YAMNet. It is a process and not a thread so that the model cannot hold the GIL
+against the stream: at a 50 ms lead, a chunk has little margin to lose. If the
+worker is busy or dead a window is dropped, and nothing in the audio path ever
+waits on it.
+
+Tested 2026-10-31 on 14 labelled clips: one 0.975 s patch per 5 s window called
+87 of 88 music windows music, and needing 5 of the last 6 to enter music
+removed every false switch (background music in news, documentaries, trailers),
+entering after about 25 s. 6.5 ms of one NAS thread per run.
+
+Clips are the raw input, before TV mode, as mono 24 kHz WAV: one when the
+decision changes, one when a window's label changes (at most one a minute), and
+one every 10 minutes, oldest deleted past MAX_SAMPLE_BYTES. Silence is neither
+measured nor saved.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+import re
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+log = logging.getLogger("streamer")
+
+RATE = 48000
+WINDOW_S = 5
+WINDOW_BYTES = RATE * WINDOW_S * 4     # s16le stereo
+SILENT_DB = -60.0
+HISTORY, ENTER = 6, 5                  # windows behind the decision, and how many to enter music
+EXIT = HISTORY - ENTER                 # at or below this many music windows, leave it
+SILENCE_RESET_S = 60                   # silence this long: whatever comes next starts afresh
+MUSIC_MIN, SPEECH_MAX, SPEECH_MIN = 0.5, 0.5, 0.3
+SAMPLE_EVERY_S = 600
+SAMPLE_GAP_S = 60
+MAX_SAMPLE_BYTES = 300 * 1024 * 1024
+MAX_LOG_BYTES = 20 * 1024 * 1024
+LOG_NAME, MARKS_NAME, OFF_NAME = "content.jsonl", "marks.jsonl", "samples-off"
+MODEL = Path(__file__).with_name("yamnet.tflite")
+
+
+def label_of(music: float, speech: float) -> str:
+    """One window."""
+    if music > MUSIC_MIN and speech < SPEECH_MAX:
+        return "music"
+    return "speech" if speech >= SPEECH_MIN else "other"
+
+
+class Decision:
+    """What a setting would follow: slow to change its mind."""
+
+    def __init__(self) -> None:
+        self.recent: list[bool] = []
+        self.state = "not music"
+
+    def push(self, label: str) -> str:
+        self.recent = (self.recent + [label == "music"])[-HISTORY:]
+        n = sum(self.recent)
+        if n >= ENTER:
+            self.state = "music"
+        elif n <= EXIT and len(self.recent) == HISTORY:
+            self.state = "not music"
+        return self.state
+
+    def reset(self) -> None:
+        self.recent = []
+        self.state = "not music"
+
+
+class SampleStore:
+    """Decides when to keep a clip, and keeps the folder under its cap."""
+
+    def __init__(self, folder: Path, cap: int = MAX_SAMPLE_BYTES) -> None:
+        self.folder = folder
+        self.cap = cap
+        self.last_at = float("-inf")
+        self.last_label = ""
+        self.last_state = ""
+
+    def wanted(self, now: float, label: str, state: str) -> str | None:
+        """Why this window should be kept, or None."""
+        why = None
+        if state != self.last_state:
+            why = "decision changed"
+        elif label != self.last_label and now - self.last_at >= SAMPLE_GAP_S:
+            why = "label changed"
+        elif now - self.last_at >= SAMPLE_EVERY_S:
+            why = "periodic"
+        self.last_label, self.last_state = label, state
+        if why:
+            self.last_at = now
+        return why
+
+    def prune(self) -> None:
+        files = sorted(self.folder.glob("*.wav"))
+        total = sum(f.stat().st_size for f in files)
+        for f in files:
+            if total <= self.cap:
+                break
+            total -= f.stat().st_size
+            f.unlink(missing_ok=True)
+
+
+def worker(folder: Path) -> None:
+    """The child process: read windows from stdin, score them, log, keep clips."""
+    import wave
+
+    import numpy as np
+    from ai_edge_litert.interpreter import Interpreter
+    from scipy.signal import resample_poly
+
+    os.nice(15)
+    folder.mkdir(parents=True, exist_ok=True)
+    it = Interpreter(str(MODEL), num_threads=1)
+    it.allocate_tensors()
+    inp, out = it.get_input_details()[0], it.get_output_details()[0]
+    import zipfile
+    names = zipfile.ZipFile(MODEL).read("yamnet_label_list.txt").decode().split("\n")
+    names = [n.strip() for n in names if n.strip()]
+    i_music, i_speech = names.index("Music"), names.index("Speech")
+    decision, store = Decision(), SampleStore(folder)
+    started, quiet_since, cpu_start = time.monotonic(), None, time.process_time()
+    logfile = folder / LOG_NAME
+    while True:
+        raw = sys.stdin.buffer.read(WINDOW_BYTES)
+        if len(raw) < WINDOW_BYTES:
+            return
+        x = np.frombuffer(raw, dtype="<i2").reshape(-1, 2).astype(np.float32).mean(axis=1) / 32768.0
+        rms = float(np.sqrt(np.mean(x ** 2)) + 1e-12)
+        db = 20 * np.log10(rms)
+        now = time.monotonic()
+        if db < SILENT_DB:
+            quiet_since = quiet_since or now
+            if now - quiet_since >= SILENCE_RESET_S:
+                decision.reset()
+            continue
+        quiet_since = None
+        patch = resample_poly(x[:46800], 1, 3).astype(np.float32)[:15600]
+        it.set_tensor(inp["index"], patch)
+        it.invoke()
+        scores = it.get_tensor(out["index"]).reshape(-1)
+        music, speech = float(scores[i_music]), float(scores[i_speech])
+        label = label_of(music, speech)
+        state = decision.push(label)
+        t = time.time()
+        rec = {"t": round(t, 1), "label": label, "decision": state, "music": round(music, 3),
+               "speech": round(speech, 3), "rms_db": round(db, 1),
+               "top": [names[i] for i in np.argsort(scores)[-3:][::-1]],
+               "cpu_s": round(time.process_time() - cpu_start, 2), "up_s": round(now - started)}
+        why = None
+        if not (folder / OFF_NAME).exists():
+            why = store.wanted(now, label, state)
+        if why:
+            name = time.strftime("%Y%m%d-%H%M%S", time.localtime(t)) + ".wav"
+            mono = resample_poly(x, 1, 2)
+            with wave.open(str(folder / name), "wb") as w:
+                w.setnchannels(1)
+                w.setsampwidth(2)
+                w.setframerate(RATE // 2)
+                w.writeframes(np.clip(mono * 32768, -32768, 32767).astype("<i2").tobytes())
+            rec["sample"], rec["why"] = name, why
+            store.prune()
+        with open(logfile, "a") as fh:
+            fh.write(json.dumps(rec) + "\n")
+        if logfile.stat().st_size > MAX_LOG_BYTES:
+            lines = logfile.read_text().splitlines(True)
+            tmp = logfile.with_suffix(".tmp")
+            tmp.write_text("".join(lines[len(lines) // 2:]))
+            tmp.replace(logfile)
+
+
+class ContentDetector:
+    """The stream's side: a copy per chunk and a pipe. Never raises into the stream."""
+
+    def __init__(self, folder: Path) -> None:
+        self.folder = folder
+        self.buf = bytearray(WINDOW_BYTES)
+        self.pos = 0
+        self.full: bytes | None = None
+        self.wake = threading.Event()
+        self.proc: subprocess.Popen | None = None
+        self.dropped = 0
+        self.available = MODEL.exists()
+
+    def start(self) -> None:
+        if self.available:
+            threading.Thread(target=self._pump, daemon=True, name="contentdetect").start()
+        else:
+            log.warning("content detector off: %s is missing", MODEL)
+
+    def feed(self, pcm: bytes) -> None:
+        n = len(pcm)
+        if self.pos + n >= WINDOW_BYTES:
+            cut = WINDOW_BYTES - self.pos
+            self.buf[self.pos:] = pcm[:cut]
+            if self.full is None:
+                self.full = bytes(self.buf)
+                self.wake.set()
+            else:
+                self.dropped += 1
+            self.buf[:n - cut] = pcm[cut:]
+            self.pos = n - cut
+        else:
+            self.buf[self.pos:self.pos + n] = pcm
+            self.pos += n
+
+    def _pump(self) -> None:
+        while True:
+            self.wake.wait()
+            self.wake.clear()
+            window, self.full = self.full, None
+            if window is None:
+                continue
+            try:
+                if self.proc is None or self.proc.poll() is not None:
+                    self.proc = subprocess.Popen(
+                        [sys.executable, str(Path(__file__)), "--worker", str(self.folder)],
+                        stdin=subprocess.PIPE)
+                self.proc.stdin.write(window)
+                self.proc.stdin.flush()
+            except OSError as e:
+                log.warning("content detector: %s; retrying in a minute", e)
+                self.proc = None
+                time.sleep(60)
+
+
+_SAMPLE = re.compile(r"^\d{8}-\d{6}\.wav$")
+
+
+def read_log(folder: Path, limit: int = 20000) -> dict:
+    records, marks = [], {}
+    try:
+        lines = (folder / LOG_NAME).read_text().splitlines()[-limit:]
+    except OSError:
+        lines = []
+    for line in lines:
+        try:
+            records.append(json.loads(line))
+        except ValueError:
+            pass
+    try:
+        for line in (folder / MARKS_NAME).read_text().splitlines():
+            m = json.loads(line)
+            marks[m["sample"]] = m["verdict"]
+    except (OSError, ValueError, KeyError):
+        pass
+    have = {f.name for f in folder.glob("*.wav")}
+    for r in records:
+        if r.get("sample") not in have:
+            r.pop("sample", None)
+    return {"records": records, "marks": marks, "saving": not (folder / OFF_NAME).exists(),
+            "bytes": sum(f.stat().st_size for f in folder.glob("*.wav")), "capBytes": MAX_SAMPLE_BYTES}
+
+
+def add_routes(app, folder: Path) -> None:
+    from aiohttp import web
+
+    folder.mkdir(parents=True, exist_ok=True)
+    page = Path(__file__).with_name("content.html")
+
+    async def show(_):
+        return web.FileResponse(page)
+
+    async def data(_):
+        return web.json_response(await asyncio.to_thread(read_log, folder))
+
+    async def sample(request):
+        name = request.match_info["name"]
+        if not _SAMPLE.match(name) or not (folder / name).is_file():
+            raise web.HTTPNotFound()
+        return web.FileResponse(folder / name)
+
+    async def mark(request):
+        body = await request.json()
+        name, verdict = str(body.get("sample", "")), body.get("verdict")
+        if not _SAMPLE.match(name) or verdict not in ("right", "wrong", None):
+            raise web.HTTPBadRequest()
+        with open(folder / MARKS_NAME, "a") as fh:
+            fh.write(json.dumps({"sample": name, "verdict": verdict, "t": round(time.time())}) + "\n")
+        return web.json_response({"ok": True})
+
+    async def saving(request):
+        body = await request.json()
+        off = folder / OFF_NAME
+        if body.get("on"):
+            off.unlink(missing_ok=True)
+        else:
+            off.touch()
+        return web.json_response({"ok": True})
+
+    async def clear(_):
+        for f in folder.glob("*.wav"):
+            f.unlink(missing_ok=True)
+        return web.json_response({"ok": True})
+
+    app.router.add_get("/content", show)
+    app.router.add_get("/content/data", data)
+    app.router.add_get("/content/sample/{name}", sample)
+    app.router.add_post("/content/mark", mark)
+    app.router.add_post("/content/saving", saving)
+    app.router.add_post("/content/clear", clear)
+
+
+if __name__ == "__main__" and len(sys.argv) == 3 and sys.argv[1] == "--worker":
+    worker(Path(sys.argv[2]))
