+"""AI switching and the two presets, against App's own methods."""
+import asyncio
+import types
+
+import pytest
+
+import streamer
+from tvdsp import TvDsp, clamp_preset
+
+
+def make(tmp_path, ai=True, active="general"):
+    a = streamer.App.__new__(streamer.App)
+    (tmp_path / "content").mkdir()
+    gen = clamp_preset({"dialogueDb": 2, "voiceCutDb": 1, "bassDb": -4, "tvLevelDb": 8, "dynamics": "normal"})
+    mus = clamp_preset({"dialogueDb": 0, "voiceCutDb": 0, "bassDb": -2, "tvLevelDb": 6, "dynamics": "off"})
+    a.settings = types.SimpleNamespace(
+        tv_presets={"general": gen, "music": mus}, tv_active=active, ai_switch=ai, tv_dialogue_db=2.0,
+        tv_voice_cut_db=1.0, tv_bass_db=-4.0, tv_level_db=8.0, tv_dynamics="normal", tv_room_eq=False,
+        tv_on=True, path=tmp_path / "settings.json", save=lambda: None)
+    a.tv = TvDsp(2, -4, "normal", True, 8, False, 1)
+    a.loop = types.SimpleNamespace(run_in_executor=lambda _e, f, *x: f(*x))
+    a.detected = None
+    return a
+
+
+def test_decision_chooses_the_preset_only_with_ai_on(tmp_path):
+    a = make(tmp_path)
+    a.on_content("music")
+    assert a.settings.tv_active == "music" and a.settings.tv_dynamics == "off"
+    a.on_content("not music")
+    assert a.settings.tv_active == "general"
+
+
+def test_ai_off_changes_nothing(tmp_path):
+    a = make(tmp_path, ai=False)
+    a.on_content("music")
+    assert a.settings.tv_active == "general" and a.detected == "music" and a.tv._glide is None
+
+
+def test_turning_ai_on_follows_what_is_being_heard(tmp_path):
+    a = make(tmp_path, ai=False)
+    a.on_content("music")
+    a.set_ai(True)
+    assert a.settings.tv_active == "music"
+
+
+def test_dead_worker_keeps_the_preset(tmp_path):
+    a = make(tmp_path)
+    a.on_content("music")
+    a.on_content(None)
+    assert a.settings.tv_active == "music" and a.detected is None
+
+
+def test_editing_the_other_preset_is_not_heard(tmp_path):
+    a = make(tmp_path)
+    a.edit_preset("music", {"dialogueDb": 5, "preset": "music"})
+    assert a.settings.tv_presets["music"]["dialogueDb"] == 5 and a.tv.dialogue_db == 2
+
+
+def test_editing_the_preset_playing_is_heard_and_kept(tmp_path):
+    a = make(tmp_path)
+    a.edit_preset("general", {"voiceCutDb": 3})
+    assert a.tv.voice_cut_db == 3 and a.settings.tv_presets["general"]["voiceCutDb"] == 3
+    assert a.settings.tv_presets["general"]["tvLevelDb"] == 8
+
+
+def test_on_off_alone_does_not_end_a_fade_or_touch_presets(tmp_path):
+    a = make(tmp_path)
+    a.on_content("music")
+    before = dict(a.settings.tv_presets["music"])
+    a.set_tv(None, None, None, False)
+    assert a.tv._glide is not None and not a.tv.enabled and a.settings.tv_presets["music"] == before
+
+
+def test_unknown_preset_is_refused(tmp_path):
+    a = make(tmp_path)
+    with pytest.raises(ValueError):
+        a.edit_preset("films", {})
+    with pytest.raises(ValueError):
+        a.use_preset("films", "by hand")
+
+
+def test_seeding_starts_both_as_the_settings_in_use(tmp_path):
+    a = make(tmp_path)
+    a.settings.tv_presets = None
+    a.settings.tv_active = "nonsense"
+    a._seed_presets()
+    assert a.settings.tv_presets["music"] == a.settings.tv_presets["general"]
+    assert a.settings.tv_presets["music"]["dialogueDb"] == 2 and a.settings.tv_active == "general"
