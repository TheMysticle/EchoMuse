+def log_mel(x, basis):
+    """EfficientAT's input without torch: 5 s at 32 kHz to [1, 1, 128, 500]."""
+    import numpy as np
+
+    x = np.asarray(x, dtype=np.float32)
+    x = x[1:] - 0.97 * x[:-1]
+    x = np.pad(x, N_FFT // 2, mode="reflect")
+    pad = (N_FFT - WIN) // 2
+    w = np.pad(np.hanning(WIN).astype(np.float32), (pad, N_FFT - WIN - pad))
+    n = 1 + (len(x) - N_FFT) // HOP
+    idx = np.arange(N_FFT)[None] + HOP * np.arange(n)[:, None]
+    s = np.fft.rfft(x[idx] * w, axis=1)
+    p = (s.real ** 2 + s.imag ** 2).astype(np.float32)
+    return ((np.log(p @ basis.T + 1e-5).T + 4.5) / 5.0)[None, None].astype(np.float32)
+
