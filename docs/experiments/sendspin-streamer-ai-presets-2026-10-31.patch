+    worst, d = _glide_steps(_p(), _p(dialogueDb=0, voiceCutDb=0, bassDb=0, tvLevelDb=2, dynamics="night"))
+    assert worst < 0.5
+    assert (d.dialogue_db, d.voice_cut_db, d.bass_db, d.tv_level_db, d.dynamics) == (0, 0, 0, 2, "night")
+    assert d._glide is None
+
+
+def test_glide_from_the_leveller_to_off_and_back_has_no_jump():
+    worst, _ = _glide_steps(_p(), _p(dynamics="off"))
+    assert worst < 0.5
+    worst, _ = _glide_steps(_p(dynamics="off"), _p())
+    assert worst < 0.5
+
+
+def test_a_hand_on_a_control_ends_the_glide():
+    d = TvDsp(2, -4, "normal", True, 8)
+    d.glide_to(_p(dialogueDb=9))
+    d.set(1, -4, "normal", 8)
+    d.process(bytes(1920))
+    assert d.dialogue_db == 1
+
+
+def test_clamp_preset_keeps_every_value_in_range():
+    from tvdsp import clamp_preset
+    p = clamp_preset({"dialogueDb": 99, "voiceCutDb": -5, "bassDb": 3, "tvLevelDb": 99, "dynamics": "loud"})
+    assert p == {"dialogueDb": 9.0, "voiceCutDb": 0.0, "bassDb": 0.0, "tvLevelDb": 24.0, "dynamics": "off", "roomEq": False}
