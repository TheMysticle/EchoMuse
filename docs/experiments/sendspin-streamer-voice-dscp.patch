 FRAMES = RATE * CHUNK_MS // 1000
 CHUNK_BYTES = FRAMES * 4  # s16le stereo
 PLAYER_ROLE = "player@v1"
+
+# Mark every connection to a player as voice traffic (DSCP CS6). Wi-Fi access
+# points with WMM, which is on by default, send it from the voice queue: the
+# shortest wait for the air, ahead of a phone's video on the same radio. The
+# router's own QoS cannot do this: it shapes only the internet link, and the
+# stream never leaves the LAN. Broadcom maps by IP precedence, so 6 -> AC_VO.
+DSCP_CS6_TOS = 48 << 2
+
+
+def _voice_socket(addr_info) -> socket.socket:
+    family, type_, proto, _, _ = addr_info
+    sock = socket.socket(family=family, type=type_, proto=proto)
+    try:
+        if family == socket.AF_INET:
+            sock.setsockopt(socket.IPPROTO_IP, socket.IP_TOS, DSCP_CS6_TOS)
+        elif family == socket.AF_INET6:
+            sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_TCLASS, DSCP_CS6_TOS)
+    except OSError as e:
+        log.warning("could not mark the player connection as voice: %s", e)
+    return sock
 SERVICE = "_sendspin._tcp.local."
 
 
