+
+
+def test_level_off_by_default_keeps_off_bit_exact():
+    d = TvDsp()
+    x = (tone(1000, -30, 0.1) * 32767).astype("<i2").tobytes()
+    assert d.process(x) == x
+
+
+def test_level_with_dynamics_off_is_a_plain_gain():
+    x = tone(1000, -40, 0.5)
+    y = run(TvDsp(level_db=12.0), x)
+    assert abs(level(y) - level(x) - 12.0) < 0.05
+
+
+def test_level_lifts_a_quiet_film_toward_music():
+    # A quiet scene at -38 dB: "normal" alone stops at its +6 dB ceiling.
+    x = tone(1000, -38, 20.0)
+    plain = level(run(TvDsp(dynamics="normal"), x))
+    lifted = level(run(TvDsp(dynamics="normal", level_db=10.0), x))
+    assert lifted - plain > 9.0
+
+
+def test_level_never_lets_a_peak_through_full_scale():
+    quiet = tone(1000, -38, 10.0)
+    bang = tone(200, -1, 0.3)
+    y = run(TvDsp(dynamics="normal", level_db=24.0), np.concatenate([quiet, bang]))
+    assert np.max(np.abs(y)) < 1.0
