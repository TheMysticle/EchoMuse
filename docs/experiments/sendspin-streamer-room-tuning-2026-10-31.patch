+def _sos_peak(fc: float, q: float, db: float) -> list[float]:
+    """RBJ peaking biquad as an sos row."""
+    a = 10 ** (db / 40)
+    w = 2 * math.pi * fc / RATE
+    al, c = math.sin(w) / (2 * q), math.cos(w)
+    a0 = 1 + al / a
+    return [(1 + al * a) / a0, -2 * c / a0, (1 - al * a) / a0, 1.0, -2 * c / a0, (1 - al / a) / a0]
+
+
+def _sos_shelf(fc: float, q: float, db: float, high: bool) -> list[float]:
+    """RBJ shelving biquad as an sos row."""
+    a = 10 ** (db / 40)
+    w = 2 * math.pi * fc / RATE
+    al, c = math.sin(w) / (2 * q), math.cos(w)
+    s = 2 * math.sqrt(a) * al
+    sign = -1 if high else 1
+    a0 = (a + 1) + sign * (a - 1) * c + s
+    return [a * ((a + 1) - sign * (a - 1) * c + s) / a0,
+            sign * 2 * a * ((a - 1) - sign * (a + 1) * c) / a0,
+            a * ((a + 1) - sign * (a - 1) * c - s) / a0,
+            1.0,
+            -sign * 2 * ((a - 1) + sign * (a + 1) * c) / a0,
+            ((a + 1) + sign * (a - 1) * c - s) / a0]
+
+
