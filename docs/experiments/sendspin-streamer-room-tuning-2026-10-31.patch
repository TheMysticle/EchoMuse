+    assert (a == b).all()
+
+
+def test_room_eq_adds_no_delay():
+    x = np.zeros((4800, 2))
+    x[100] = 0.3
+    y = run(TvDsp(room_eq=True), x)
+    assert np.argmax(np.abs(y[:, 0])) == 100
+    assert np.all(y[:100] == 0)
+
+
+def test_room_eq_chunk_size_does_not_change_the_output():
+    rng = np.random.default_rng(1)
+    x = rng.normal(0, 0.05, (4800, 2))
+    a = run(TvDsp(room_eq=True), x, 480)
+    b = run(TvDsp(room_eq=True), x, 240)
+    assert np.max(np.abs(a - b)) < 1e-9
+
+
+def test_room_eq_shape():
+    def gain(f, **kw):
+        x = tone(f, -30, 1.0)
+        return level(run(TvDsp(room_eq=True, **kw), x)) - level(x)
+    assert gain(430) < -3.5
