+class VolumeSync:
+    """Keeps the players in the stream at one volume.
+
+    A player that reports a new volume (its buttons, Home Assistant, the page)
+    has it copied to the others. Two kinds of report are not a change, and
+    copying either would make the players fight:
+
+    - What a player says as it joins is where it already was. A rebooted Echo
+      announcing the level it restored must not move the rest.
+    - A player answers a volume it was sent by reporting it, rounded to its
+      own steps (an Echo has 30, about 3.4% apart). Copying the answer back
+      would make two players with different steps chase each other, and a
+      quick run of button presses would be pulled back to an earlier one.
+
+    Pure bookkeeping on an injected clock: the caller sends what reported()
+    returns.
+    """
+
+    JOIN_GRACE_S = 5.0     # reports this soon after joining are the join itself
+    ANSWER_S = 3.0         # how long a sent volume waits for its answer
+    ANSWER_TOLERANCE = 4   # percent; one Echo step either way
+
+    def __init__(self, clock=time.monotonic) -> None:
+        self.clock = clock
+        self._joined: dict[str, float] = {}
+        self._sent: dict[str, list[tuple[int, float]]] = {}
+
+    def members(self, ids) -> None:
+        """The players in the stream now. A newcomer starts its grace."""
+        now = self.clock()
+        ids = set(ids)
+        for i in ids:
+            self._joined.setdefault(i, now)
+        for i in list(self._joined):
+            if i not in ids:
+                del self._joined[i]
+                self._sent.pop(i, None)
+
+    def reported(self, who: str, volume: int, volumes: dict[str, int | None]) -> dict[str, int]:
+        """A player reported volume. volumes holds every member's last report.
+        Returns {player: volume} to send."""
+        now = self.clock()
+        joined = self._joined.get(who)
+        if joined is None or now - joined < self.JOIN_GRACE_S:
+            return {}
+        sent = [(v, t) for v, t in self._sent.get(who, []) if now - t < self.ANSWER_S]
+        for k, (v, _) in enumerate(sent):
+            if v == volume:
+                self._sent[who] = sent[k + 1:]
+                return {}
+        if sent and abs(volume - sent[-1][0]) <= self.ANSWER_TOLERANCE:
+            self._sent[who] = []
+            return {}
+        self._sent[who] = []
+        out = {}
+        for other in self._joined:
+            if other == who or volumes.get(other) == volume:
+                continue
+            out[other] = volume
+            self._sent.setdefault(other, []).append((volume, now))
+        return out
+
+
