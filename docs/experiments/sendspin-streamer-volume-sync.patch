+"""VolumeSync's rules. Run: python -m pytest test_volume_sync.py (or plain python)."""
+import importlib.util
+import pathlib
+import sys
+
+spec = importlib.util.spec_from_file_location("streamer", pathlib.Path(__file__).with_name("streamer.py"))
+streamer = importlib.util.module_from_spec(spec)
+sys.modules["streamer"] = streamer
+spec.loader.exec_module(streamer)
+VolumeSync = streamer.VolumeSync
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1000.0
+
+    def __call__(self):
+        return self.t
+
+
+def joined(*ids):
+    c = Clock()
+    s = VolumeSync(clock=c)
+    s.members(ids)
+    c.t += VolumeSync.JOIN_GRACE_S
+    return s, c
+
+
+def test_a_change_is_copied_to_the_others():
+    s, _ = joined("a", "b", "c")
+    assert s.reported("a", 54, {"a": 54, "b": 50, "c": 50}) == {"b": 54, "c": 54}
+
+
+def test_a_player_already_there_is_not_sent_anything():
+    s, _ = joined("a", "b")
+    assert s.reported("a", 54, {"a": 54, "b": 54}) == {}
+
+
+def test_the_answer_to_a_sent_volume_is_not_copied_back():
+    s, _ = joined("a", "b")
+    s.reported("a", 54, {"a": 54, "b": 50})
+    assert s.reported("b", 54, {"a": 54, "b": 54}) == {}
+
+
+def test_a_rounded_answer_is_not_copied_back():
+    s, _ = joined("a", "b")
+    s.reported("a", 55, {"a": 55, "b": 50})
+    assert s.reported("b", 54, {"a": 55, "b": 54}) == {}
+
+
+def test_a_quick_run_of_presses_is_not_pulled_back():
+    s, _ = joined("a", "b")
+    s.reported("a", 50, {"a": 50, "b": 47})
+    s.reported("a", 54, {"a": 54, "b": 47})
+    s.reported("a", 57, {"a": 57, "b": 47})
+    # b's answers arrive after the run: none is a change
+    assert s.reported("b", 50, {"a": 57, "b": 50}) == {}
+    assert s.reported("b", 54, {"a": 57, "b": 54}) == {}
+    assert s.reported("b", 57, {"a": 57, "b": 57}) == {}
+
+
+def test_a_press_after_the_answer_is_a_change():
+    s, c = joined("a", "b")
+    s.reported("a", 54, {"a": 54, "b": 50})
+    s.reported("b", 54, {"a": 54, "b": 54})
+    c.t += 0.5
+    assert s.reported("b", 57, {"a": 54, "b": 57}) == {"a": 57}
+
+
+def test_an_unanswered_volume_stops_swallowing_reports():
+    s, c = joined("a", "b")
+    s.reported("a", 54, {"a": 54, "b": 50})
+    c.t += VolumeSync.ANSWER_S
+    assert s.reported("b", 57, {"a": 54, "b": 57}) == {"a": 57}
+
+
+def test_a_far_off_report_while_one_is_owed_is_a_change():
+    s, _ = joined("a", "b")
+    s.reported("a", 54, {"a": 54, "b": 50})
+    assert s.reported("b", 20, {"a": 54, "b": 20}) == {"a": 20}
+
+
+def test_a_newcomer_does_not_move_the_rest():
+    s, c = joined("a", "b")
+    s.members(["a", "b", "c"])
+    assert s.reported("c", 30, {"a": 54, "b": 54, "c": 30}) == {}
+    c.t += VolumeSync.JOIN_GRACE_S
+    assert s.reported("c", 33, {"a": 54, "b": 54, "c": 33}) == {"a": 33, "b": 33}
+
+
+def test_a_newcomer_follows_a_change_made_during_its_grace():
+    s, _ = joined("a", "b")
+    s.members(["a", "b", "c"])
+    assert s.reported("a", 60, {"a": 60, "b": 54, "c": 30}) == {"b": 60, "c": 60}
+
+
+def test_a_player_not_in_the_stream_is_ignored_and_untouched():
+    s, _ = joined("a", "b")
+    assert s.reported("x", 10, {"a": 54, "b": 54}) == {}
+    assert "x" not in s.reported("a", 60, {"a": 60, "b": 54, "x": 10})
+
+
+def test_leaving_forgets_what_a_player_owed():
+    s, c = joined("a", "b")
+    s.reported("a", 54, {"a": 54, "b": 50})
+    s.members(["a"])
+    s.members(["a", "b"])
+    c.t += VolumeSync.JOIN_GRACE_S
+    assert s.reported("b", 54, {"a": 60, "b": 54}) == {"a": 54}
+
+
+def test_with_no_members_nothing_is_sent():
+    s, _ = joined()
+    assert s.reported("a", 54, {"a": 54}) == {}
+
+
