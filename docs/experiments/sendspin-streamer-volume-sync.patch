+    def _track_volumes(self, ready) -> None:
+        """Follow the volume of every player in the stream (VolumeSync)."""
+        self._ready_clients = {c.client_id: c for c in ready}
+        self.volsync.members(self._ready_clients if self.settings.volume_sync else ())
+        for cid, c in self._ready_clients.items():
+            held = self._vol_watch.get(cid)
+            if held and held[0] is c:
+                continue
+            if held:
+                held[1]()
+            self._vol_watch[cid] = (c, c.add_event_listener(self._client_event))
+
+    def _client_event(self, client, event) -> None:
+        # Called inside aiosendspin's event dispatch: nothing here may raise
+        # into it.
+        try:
+            self._sync_volume(client, event)
+        except Exception:
+            log.exception("volume sync")
+
+    def _sync_volume(self, client, event) -> None:
+        if not isinstance(event, VolumeChangedEvent) or not self.settings.volume_sync:
+            return
+        if self._ready_clients.get(client.client_id) is not client:
+            return
+        volumes = {}
+        for cid, c in self._ready_clients.items():
+            r = c.role(PLAYER_ROLE)
+            volumes[cid] = r.volume if r else None
+        for cid, v in self.volsync.reported(client.client_id, event.volume, volumes).items():
+            r = self._ready_clients[cid].role(PLAYER_ROLE)
+            if r is None:
+                continue
+            log.info("volume %d from %s -> %s", v, self._label(client), self._label(self._ready_clients[cid]))
+            r.set_volume(v)
+
+    def _label(self, client) -> str:
+        for key, p in self.discovery.players.items():
+            if self.client_for(key) is client:
+                return p.label
+        return client.client_id
+
+    def set_volume_sync(self, on: bool) -> None:
+        self.settings.volume_sync = on
+        self.settings.save()
+        self.volsync = VolumeSync(self.volsync.clock)  # a fresh start: nobody owes an answer
+        self.volsync.members(self._ready_clients if on else ())
