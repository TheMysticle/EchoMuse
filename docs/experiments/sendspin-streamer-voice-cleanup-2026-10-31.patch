+def test_voice_cut_lowers_the_centre_and_not_the_sides():
+    centre, wide = tone(250, -20), tone(250, -20, side=True)
+    assert abs(level(run(TvDsp(voice_cut_db=4.0), centre)) - level(centre) + 4.0) < 0.3
+    assert abs(level(run(TvDsp(voice_cut_db=4.0), wide)[RATE // 2:]) - level(wide)) < 0.05
+
+
+def test_voice_cut_leaves_speech_consonants_alone():
+    x = tone(3000, -20)
+    assert abs(level(run(TvDsp(voice_cut_db=6.0), x)[RATE // 2:]) - level(x)) < 0.6
+
+
+def test_voice_cut_adds_no_delay():
+    x = np.zeros((RATE // 10, 2))
+    x[0] = 0.5
+    y = run(TvDsp(voice_cut_db=6.0), x)
+    assert int(np.argmax(np.abs(y[:, 0]))) == 0
