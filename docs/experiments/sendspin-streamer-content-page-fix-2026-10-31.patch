+def read_log_from(folder: Path, offset: int) -> tuple[bytes, int, bool]:
+    """Whole lines of the log after a byte offset, the offset to ask from next, and
+    whether the log was rotated so that the reader must start again.
+
+    NEVER parse the log in this process. This runs beside the stream, and parsing
+    it line by line for the page's 15 s refresh held the GIL for 70 ms with 2,400
+    lines and growing, then 12 ms more encoding it on the stream's own loop: the
+    stream's lead fell from 45 ms to about 30 in exactly the 10 s windows holding a
+    refresh (2026-10-31), and the cost grew with the log. The browser parses it."""
+    try:
+        with open(folder / LOG_NAME, "rb") as fh:
+            size = fh.seek(0, os.SEEK_END)
+            reset = offset < 0 or offset > size
+            start = 0 if reset else offset
+            fh.seek(start)
+            data = fh.read()
+    except OSError:
+        return b"", 0, offset != 0
+    end = data.rfind(b"\n") + 1  # a line still being written waits for the next refresh
+    return data[:end], start + end, reset
 
 
