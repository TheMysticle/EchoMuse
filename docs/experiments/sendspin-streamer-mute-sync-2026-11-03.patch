+# ── MuteSync ───────────────────────────────────────────────────────────────
+
+MuteSync = streamer.MuteSync
+
+
+def mjoined(*ids, muted=False):
+    c = Clock()
+    s = MuteSync(clock=c)
+    s.members(ids)
+    for i in ids:
+        s.reported(i, muted, {})  # the join report: where it already was
+    c.t += MuteSync.JOIN_GRACE_S
+    return s, c
+
+
+def test_a_mute_is_copied_to_the_others():
+    s, _ = mjoined("a", "b", "c")
+    assert s.reported("a", True, {"a": True, "b": False, "c": False}) == {"b": True, "c": True}
+
+
+def test_an_unmute_is_copied_too():
+    s, _ = mjoined("a", "b", muted=True)
+    assert s.reported("a", False, {"a": False, "b": True}) == {"b": False}
+
+
+def test_a_volume_report_with_the_mute_unchanged_is_not_a_mute():
+    s, _ = mjoined("a", "b")
+    assert s.reported("a", False, {"a": False, "b": False}) == {}
+
+
+def test_the_answer_to_a_sent_mute_is_not_copied_back():
+    s, _ = mjoined("a", "b")
+    assert s.reported("a", True, {"a": True, "b": False}) == {"b": True}
+    assert s.reported("b", True, {"a": True, "b": True}) == {}
+
+
+def test_a_player_joining_muted_does_not_mute_the_room():
+    c = Clock()
+    s = MuteSync(clock=c)
+    s.members(["a", "b"])
+    assert s.reported("b", True, {"a": False, "b": True}) == {}
+    c.t += MuteSync.JOIN_GRACE_S
+    assert s.reported("b", True, {"a": False, "b": True}) == {}
