+class MuteSync:
+    """Keeps the players in the stream muted together, as VolumeSync keeps
+    their volume.
+
+    A player that changes its mute (Home Assistant's mute on an Echo, the
+    page) has it copied to the others. Before EchoMuse firmware reported its
+    mute as a mute, it reported volume 0, so VolumeSync muted the room by
+    setting everyone's volume to 0 and nothing showed muted. What a player
+    says as it joins, and its answer to a mute it was sent, are not changes.
+    Only a CHANGE of a player's mute counts: the event that carries it fires
+    for every volume report too.
+    """
+
+    JOIN_GRACE_S = VolumeSync.JOIN_GRACE_S
+    ANSWER_S = VolumeSync.ANSWER_S
+
+    def __init__(self, clock=time.monotonic) -> None:
+        self.clock = clock
+        self._joined: dict[str, float] = {}
+        self._last: dict[str, bool] = {}
+        self._sent: dict[str, tuple[bool, float]] = {}
+
+    def members(self, ids) -> None:
+        now = self.clock()
+        ids = set(ids)
+        for i in ids:
+            self._joined.setdefault(i, now)
+        for i in list(self._joined):
+            if i not in ids:
+                del self._joined[i]
+                self._last.pop(i, None)
+                self._sent.pop(i, None)
+
+    def reported(self, who: str, muted: bool, mutes: dict[str, bool | None]) -> dict[str, bool]:
+        """A player reported its state. mutes holds every member's last
+        report. Returns {player: muted} to send."""
+        now = self.clock()
+        prev = self._last.get(who)
+        self._last[who] = muted
+        joined = self._joined.get(who)
+        if joined is None or now - joined < self.JOIN_GRACE_S:
+            return {}
+        if prev is None or prev == muted:
+            return {}
+        sent = self._sent.pop(who, None)
+        if sent and sent[0] == muted and now - sent[1] < self.ANSWER_S:
+            return {}
+        out = {}
+        for other in self._joined:
+            if other == who or mutes.get(other) == muted:
+                continue
+            out[other] = muted
+            self._sent[other] = (muted, now)
+            self._last[other] = muted
+        return out
+
